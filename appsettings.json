{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AiDatabase": "" // Set per-environment in appsettings.{ENV}.json or user secrets
  },
  "FileStorage": {
    "AiDocumentsBasePath": "" // UNC path to the network share, e.g. \\\\server\\share\\ai-docs
  },
  "AppSettings": {
    "ApplicationName": "MangoSPA.BFF",
    "Environment": "",
    "IsInKubernetes": false,
    "EnableCaching": true,
    "UseInMemoryCaching": true
  },
  "ServicesUrls": {
    "IdentityApiUrl": "",
    "FormsApiBaseUrl": "" // Set per-environment; DEV: https://api.dev.corp.virtualpremise.com:30443/FormsEngine/api/
  },
  "Auth": {
    "CookieExpireInMinutes": 1440, // 24 hours
    "CorsOrigins": [
      "https://*.costarremanager.com",
      "https://*.corp.virtualpremise.com",
      "https://*.corp.virtualpremise.com:30443",
      "http://*.corp.virtualpremise.com",
      "http://*.corp.virtualpremise.com:30080"
    ]
  },
  "Redis": {
    "Connection": "",
    "Port": 6379,
    "Instance": "",
    "Token": "",
    "UseSSL": false
  },
  "RateLimit": {
    "WindowInSeconds": 20,
    "PermitLimit": 100
  },
  // Route all incoming requests to nginx (the entry point to the microservices that live in k8s)
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "nginx-service",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            // authentication cookie is not needed when calling the microservices. Only the JWT
            "RequestHeaderRemove": "Cookie"
          }
        ]
      },
      // Exempt routes - no rate limiter policy
      "route-etl-upload": {
        "ClusterId": "nginx-service",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "etl/api/etldocumentmigration/uploadchunk/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderRemove": "Cookie"
          }
        ]
      },
      // Rate limiting for all POST/PUT/DELETE/PATCH endpoints
      "route-post": {
        "ClusterId": "nginx-service",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "fixed-by-user-and-path",
        "Match": {
          "Path": "{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
        },
        "Transforms": [
          {
            // authentication cookie is not needed when calling the microservices. Only the JWT
            "RequestHeaderRemove": "Cookie"
          }
        ]
      },
      "route-iad": {
        "ClusterId": "nginx-service",
        "Timeout": "00:05:00",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "accountingDashboard/api/IAD/{**catch-all}"
        },
        "Transforms": [
          {
            // authentication cookie is not needed when calling the microservices. Only the JWT
            "RequestHeaderRemove": "Cookie"
          }
        ]
      }
    },
    "Clusters": {
      "nginx-service": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "https://api.dev.corp.virtualpremise.com:30443/"
          }
        }
      }
    }
  }
}
